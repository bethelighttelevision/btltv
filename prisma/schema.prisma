generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Show {
  id          String    @id @default(cuid())
  title       String
  titleUrdu   String?
  slug        String    @unique
  category    String    @default("Talk Show")
  playlistId  String    @default("")
  thumbnail   String?
  description String?
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  videos      Video[]
}

model Video {
  id            String   @id @default(cuid())
  showId        String
  show          Show     @relation(fields: [showId], references: [id], onDelete: Cascade)
  title         String
  youtubeId     String
  thumbnail     String?
  description   String?
  episodeNumber Int?
  publishedAt   DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model TeamMember {
  id           String   @id @default(cuid())
  name         String
  designation  String?
  photo        String?
  bio          String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveStream {
  id              String   @id @default(cuid())
  streamUrl       String?
  isLive          Boolean  @default(false)
  offlineMessage  String?
  schedule        String?
  updatedAt       DateTime @updatedAt
}

model PageContent {
  id         String   @id @default(cuid())
  pageKey    String
  fieldKey   String
  fieldValue String?
  updatedAt  DateTime @updatedAt

  @@unique([pageKey, fieldKey])
}

model Setting {
  key       String   @id
  value     String?
  updatedAt DateTime @updatedAt
}

model Review {
  id             String   @id @default(cuid())
  name           String
  email          String?
  rating         Int      // 1-5
  comment        String
  source         String   @default("site") // "site" | "google"
  googleReviewId String?
  isApproved     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AppDownload {
  id        String   @id @default(cuid())
  platform  String   @default("android")
  version   String   @default("1.0.0")
  ip        String?
  city      String?
  country   String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())
}
